prototype(Neos.Seo:RobotsTxt) {
    data {
        contentSignal = Neos.Fusion:Join {
            # Site nodes created before the installation store no value yet; they get the node type default, not "no"
            @context.signals = Neos.Fusion:Map {
                items = ${{aiTrain: 'contentSignalAiTrain', search: 'contentSignalSearch', aiInput: 'contentSignalAiInput'}}
                itemRenderer = ${(Type.isBoolean(q(site).property(item)) ? q(site).property(item) : site.nodeType.defaultValuesForProperties[item]) ? 'yes' : 'no'}
            }
            @glue = ', '
            1 = ${'Content-Signal: ai-train=' + signals.aiTrain}
            2 = ${'search=' + signals.search}
            3 = ${'ai-input=' + signals.aiInput}
            @position = 'after userAgentAll'
        }
        llmsTxt = Neos.Neos:NodeUri {
            node = ${site}
            format = 'txt.llms'
            absolute = true
            @position = 'after contentSignal'
            @process.wrapAsComment = ${'# LLM-friendly overview for AI agents: ' + value}
        }
    }
}
